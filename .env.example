# Sri Subhakari Fashions — Environment Variables
# Copy this file to .env and fill in your Supabase credentials

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Sanity CMS Configuration
VITE_SANITY_PROJECT_ID=your_sanity_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2023-01-01

# How to get these values:
# 1. Go to https://sanity.io and create or log in to your Sanity project
# 2. Copy your Project ID and dataset name (default: production)
# 3. Paste them above in your .env file
# 4. Add the same environment variables to Vercel for production deployment

